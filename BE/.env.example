# Spring Boot does not load this file automatically. Never place real secrets here.
DB_URL=jdbc:mysql://localhost:3306/dacn?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=your_database_user
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION=86400000

VNPAY_TMN_CODE=replace_me
VNPAY_HASH_SECRET=replace_me
